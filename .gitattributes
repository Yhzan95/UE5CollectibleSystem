# Normalisation par defaut pour le texte
* text=auto

# --- Assets Unreal : binaires, jamais de conversion de fin de ligne ni de merge ---
*.uasset binary
*.umap   binary
*.upk    binary
*.udk    binary
*.ubulk  binary
*.uexp   binary

# --- Medias / binaires divers ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.bmp  binary
*.psd  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.obj  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.dll  binary
*.lib  binary
*.pdb  binary
*.exe  binary

# --- Fichiers texte du projet : fins de ligne Windows ---
*.uproject text eol=crlf
*.ini      text eol=crlf
*.cs       text eol=crlf
*.cpp      text eol=crlf
*.h        text eol=crlf
